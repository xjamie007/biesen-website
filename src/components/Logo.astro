---
/**
 * Logo (B7): bis zur Vektordatei das Original-PNG (485 × 298 px), nicht nachgezeichnet,
 * nicht verändert. Ausgeliefert verkleinert als WebP in höchster Qualität (ein Drittel der Größe
 * des PNG, Kanten und Schrift bleiben sauber), PNG als Rückfall; einfache, doppelte und dreifache Dichte.
 * Steht immer auf reinem Weiß, weil das Logo selbst einen weißen Grund hat.
 * Höhe per CSS: 52 px mobil, 72 px ab 960 px, beim Scrollen 56 px.
 */
import { Picture } from 'astro:assets';
import logo from '@/assets/brand/logo.png';

interface Props {
  alt: string;
  loading?: 'eager' | 'lazy';
}
const { alt, loading = 'eager' } = Astro.props;
---
<Picture
  src={logo}
  alt={alt}
  height={72}
  densities={[1, 2, 3]}
  formats={['webp']}
  fallbackFormat="png"
  quality="max"
  loading={loading}
  decoding="async"
/>
