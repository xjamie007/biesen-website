---
/** Ein Symbol aus src/lib/icons.ts. Immer dekorativ (aria-hidden); der Text daneben trägt die Bedeutung. */
import { ICONS, type IconName } from '@/lib/icons';

interface Props {
  name: IconName;
  class?: string;
  size?: number;
}
const { name, class: klasse, size = 24 } = Astro.props;
---
<svg
  class:list={['icon', klasse]}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={ICONS[name]}
/>
