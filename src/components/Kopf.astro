---
/**
 * Kopf (C4) in zwei Teilen:
 * 1. Kontaktleiste in Nachtblau: Telefon, Zeiten kurz, E-Mail und die Sprachen LU, DE, EN, FR.
 *    Sie scrollt mit weg.
 * 2. Hauptkopf in Weiß (nie durchscheinend, damit das Logo auf seinem eigenen Weiß steht):
 *    Logo, alle Seiten, Knopf „Angebot anfragen“. Bleibt beim Scrollen oben und wird flacher.
 * Unter 768 px: „Anrufen“ und „Menü“; das Menü öffnet sich als weiße Fläche mit Fokusfalle
 * (src/scripts/menue.ts). „Leistungen“ ist mit JavaScript ein Aufklapp-Menü mit allen fünf
 * Leistungen und der Übersicht, ohne JavaScript ein Link auf die Übersichtsseite.
 * Ohne JavaScript steht die Navigation mobil offen unter der Kopfzeile.
 */
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import Sprachen from './Sprachen.astro';
import type { Dict } from '@/i18n';
import { path, SERVICE_PAGES, type Lang } from '@/i18n/config';
import { mailHref, site, telHref } from '@/lib/site';
import { LEISTUNG_ICON } from '@/lib/icons';
import { kurzText } from '@/lib/zeiten';

interface Props {
  lang: Lang;
  t: Dict;
  alternates: { lang: Lang; href: string }[];
  aktuell: string;
}
const { lang, t, alternates, aktuell } = Astro.props;
const cur = (p: string) => (aktuell === p ? 'page' : undefined);
const home = path(lang, 'home');
const istLeistung = aktuell === 'leistungen' || (SERVICE_PAGES as readonly string[]).includes(aktuell);
---
<div class="topbar">
  <div class="raster">
    <div class="topbar__zeile">
      <ul class="topbar__kontakt">
        <li>
          <a href={telHref}>
            <Icon name="telefon" size={16} />
            <span class="sr-only">{t.allgemein.telefon} </span><span class="zahl">{site.telefon.anzeige}</span>
          </a>
        </li>
        <li class="topbar__zeiten">
          <Icon name="uhr" size={16} />
          <span class="zahl">{kurzText(t)}</span>
        </li>
        <li class="topbar__mail">
          <a href={mailHref}>
            <Icon name="mail" size={16} />
            <span class="sr-only">{t.allgemein.email} </span>{site.email}
          </a>
        </li>
      </ul>
      <Sprachen lang={lang} t={t} alternates={alternates} id="sprache-kopf" />
    </div>
  </div>
</div>
<header class="kopf">
  <div class="raster">
    <div class="kopf__zeile">
      <a class="kopf__logo" href={home}><Logo alt={t.a11y.logo} /></a>
      <div class="kopf__mobil">
        <a class="knopf kopf__anrufen" href={telHref}><Icon name="telefon" size={18} /><span class="kopf__anrufen-text">{t.a11y.anrufen}</span></a>
        <button class="menueknopf" type="button" aria-expanded="false" aria-controls="navigation" data-menue-auf>
          <span class="menueknopf__striche" aria-hidden="true"></span>
          {t.a11y.menue}
        </button>
      </div>
      <nav class="nav" id="navigation" aria-label={t.a11y.hauptnavigation}>
        <div class="nav__kopf">
          <a class="kopf__logo" href={home} tabindex="-1" aria-hidden="true"><Logo alt="" loading="lazy" /></a>
          <button class="menueknopf" type="button" data-menue-zu>{t.a11y.schliessen}</button>
        </div>
        <ul class="nav__liste nav__liste--haupt">
          <li class="nav__haupt-li">
            <a class="nav__link nav__leistungen-link" href={path(lang, 'leistungen')} aria-current={cur('leistungen')}>
              {t.nav.leistungen}
            </a>
            <button
              class="nav__knopf"
              type="button"
              aria-expanded="false"
              aria-controls="nav-leistungen"
              data-untermenue
              data-aktiv={istLeistung ? '' : undefined}
            >
              {t.nav.leistungen}
              <svg class="nav__pfeil" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" focusable="false">
                <path d="m2.5 4.5 3.5 3.5 3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
            <span class="nav__gruppe" aria-hidden="true">{t.nav.leistungen}</span>
            <ul class="nav__liste nav__unter" id="nav-leistungen" hidden>
              {
                SERVICE_PAGES.map((p) => (
                  <li>
                    <a class:list={['nav__link', 'nav__leistung', `farbe--${p}`]} href={path(lang, p)} aria-current={cur(p)}>
                      <span class="symbol symbol--klein" aria-hidden="true"><Icon name={LEISTUNG_ICON[p]} size={20} /></span>
                      <span>{t.leistungen[p].name}</span>
                    </a>
                  </li>
                ))
              }
              <li class="nav__alle">
                <a class="nav__link" href={path(lang, 'leistungen')} aria-current={cur('leistungen')}>
                  <span>{t.nav.alleLeistungen}</span>
                  <Icon name="pfeil" size={18} />
                </a>
              </li>
            </ul>
          </li>
          <li><a class="nav__link" href={path(lang, 'projekte')} aria-current={cur('projekte')}>{t.nav.projekte}</a></li>
          <li><a class="nav__link" href={path(lang, 'ueberUns')} aria-current={cur('ueberUns')}>{t.nav.ueberUns}</a></li>
          <li>
            <a class="nav__link" href={path(lang, 'jobs')} aria-current={cur('jobs') ?? (aktuell === 'job' ? 'true' : undefined)}>
              {t.nav.jobs}
            </a>
          </li>
          <li><a class="nav__link" href={path(lang, 'kontakt')} aria-current={cur('kontakt')}>{t.nav.kontakt}</a></li>
        </ul>
        <div class="nav__extra">
          <a class="knopf knopf--giel nav__aktion" href={path(lang, 'kontakt')}>
            {t.allgemein.angebotAnfragen}
            <Icon name="pfeil" size={18} />
          </a>
          <a class="nav__telefon" href={telHref}>
            <Icon name="telefon" size={18} />
            <span class="sr-only">{t.allgemein.telefon} </span><span class="zahl">{site.telefon.anzeige}</span>
          </a>
          <div class="nav__sprachen">
            <Sprachen lang={lang} t={t} alternates={alternates} id="sprache-menue" />
          </div>
        </div>
      </nav>
    </div>
  </div>
</header>

<script>
  import { initMenue } from '@/scripts/menue';
  initMenue();
</script>
