---
/**
 * Kopf der Unterseiten als helles Band: sichtbarer Pfad (passt zur BreadcrumbList),
 * auf Leistungsseiten das Symbol der Leistung, h1, Einleitung. Der Slot steht unter der Einleitung.
 */
import Icon from './Icon.astro';
import { rich } from '@/i18n';
import type { IconName } from '@/lib/icons';

interface Props {
  /** Leistungsseite: setzt die Akzentfarbe des Symbols */
  farbe?: string;
  pfadLabel: string;
  pfad: { name: string; href: string }[];
  h1: string;
  intro?: string;
  introHtml?: Record<string, string>;
  icon?: IconName;
}
const { pfadLabel, pfad, h1, intro, introHtml = {}, icon, farbe } = Astro.props;
---
<div class:list={['raster', 'seitenkopf', farbe && `farbe--${farbe}`]}>
  <div class="seitenkopf__inhalt">
    <nav aria-label={pfadLabel}>
      <ol class="pfad__liste klein">
        {
          pfad.map((p, i) =>
            i === pfad.length - 1 ? (
              <li aria-current="page">{p.name}</li>
            ) : (
              <li>
                <a href={p.href}>{p.name}</a>
              </li>
            ),
          )
        }
      </ol>
    </nav>
    {icon && <span class="symbol symbol--gross seitenkopf__symbol" aria-hidden="true"><Icon name={icon} size={32} /></span>}
    <h1>{h1}</h1>
    {intro && <p class="lead" set:html={rich(intro, introHtml)} />}
    <slot />
  </div>
</div>
