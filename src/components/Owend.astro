---
/**
 * Owend im Hero (C5): Tag- und Abendfoto vom selben Stativ übereinander.
 * Beim ersten Scrollen blendet das Tagfoto ins Abendfoto über (CSS Scroll-Driven Animations,
 * nur Deckkraft). Fallbacks:
 *   1. ohne Scroll-Driven Animations, mit JavaScript: Intersection Observer (Inline-Script < 1 KB)
 *   2. ohne beides: Abendfoto statisch
 *   3. reduzierte Bewegung: beide Fotos als Paar, jedes mit seiner Uhrzeit
 *   4. kein freigegebenes Paar: ein gezeichnetes Haus im Ösling am Nachmittag und zur blauen Stunde
 *      (OwendSzene), das genauso überblendet, mit dem Hinweis „Fotopaar folgt: [Motiv]“
 * Die Bildunterschrift ist statisch und nennt beide Uhrzeiten.
 */
import { Picture } from 'astro:assets';
import OwendSzene from './OwendSzene.astro';
import Icon from './Icon.astro';
import { fmt, rich, type Dict } from '@/i18n';
import type { Paar } from '@/lib/projekte';

interface Props {
  t: Dict;
  paar: Paar;
}
const { t, paar } = Astro.props;
const b = paar.bilder;
const breiten = [480, 768, 1080, 1600, 2000];
/**
 * Das Original ist ein Querformat (Shooting-Anleitung), angezeigt wird mobil ein 4:5-Ausschnitt und am
 * Desktop etwa 1:1 (Spalten 6–12, Höhe min(86svh, 880px)). Damit der Ausschnitt scharf bleibt, rechnet
 * sizes mit der Breite, die das Bild bei object-fit: cover tatsächlich bekommt.
 */
const seiten = b ? b.tag.bild.width / b.tag.bild.height : 1.5;
const mobil = Math.round(100 * Math.max(1, seiten / 0.8));
const desktop = Math.min(100, Math.round(57 * Math.max(1, seiten / 1.05)));
const sizes = `(min-width: 1024px) ${desktop}vw, ${mobil}vw`;
const ortFehlt = !paar.ort || !paar.projekt;
const zeitFehlt = !b || !b.tag.uhrzeit || !b.abend.uhrzeit;
---
<figure class:list={['owend', 'owend--animiert', !b && 'owend--szene']} style={`--fokus:${paar.fokus}`}>
  <div
    class="owend__stapel"
    style={paar.test ? 'position:relative' : undefined}
    role={b ? undefined : 'img'}
    aria-label={b ? undefined : fmt(t.allgemein.fotopaarFolgt, { motiv: paar.motiv })}
  >
    {
      b ? (
        <>
          <div class="owend__bild owend__tag">
            <Picture
              src={b.tag.bild}
              alt={b.tag.alt}
              formats={['avif', 'webp']}
              widths={breiten.filter((w) => w <= b.tag.bild.width)}
              sizes={sizes}
              loading="eager"
              fetchpriority="high"
            />
            <p class="owend__zeit klein neben">{fmt(t.owend.tagZeit, { zeit: b.tag.uhrzeit })}</p>
          </div>
          <div class="owend__bild owend__abend">
            <Picture
              src={b.abend.bild}
              alt={b.abend.alt}
              formats={['avif', 'webp']}
              widths={breiten.filter((w) => w <= b.abend.bild.width)}
              sizes={sizes}
              loading="eager"
              fetchpriority="low"
              decoding="async"
            />
            <p class="owend__zeit klein neben">{fmt(t.owend.abendZeit, { zeit: b.abend.uhrzeit })}</p>
          </div>
          {paar.test && <span class="testmarke">Dev: {paar.motiv}</span>}
        </>
      ) : (
        <>
          <div class="owend__bild owend__tag">
            <OwendSzene variante="tag" />
          </div>
          <div class="owend__bild owend__abend">
            <OwendSzene variante="abend" />
          </div>
          <p class="owend__folgt" aria-hidden="true">
            <Icon name="kamera" size={18} />
            {fmt(t.allgemein.fotopaarFolgt, { motiv: paar.motiv })}
          </p>
        </>
      )
    }
  </div>
  <figcaption class="klein neben">
    {
      b && !ortFehlt && !zeitFehlt ? (
        <Fragment
          set:html={fmt(t.owend.bildunterschrift, {
            ort: paar.ort,
            projekt: paar.projekt,
            tag: `<time>${b.tag.uhrzeit}</time>`,
            abend: `<time>${b.abend.uhrzeit}</time>`,
          })}
        />
      ) : (
        <Fragment set:html={rich(t.owend.bildunterschriftFehlt)} />
      )
    }
  </figcaption>
</figure>
<div class="owend__marke" aria-hidden="true" />
<script is:inline>
  (function () {
    var f = document.querySelector('.owend--animiert');
    var m = document.querySelector('.owend__marke');
    if (!f || !m || !('IntersectionObserver' in window)) return;
    if (window.CSS && CSS.supports('animation-timeline: scroll()')) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    f.classList.add('owend--js');
    new IntersectionObserver(function (e) {
      var x = e[e.length - 1];
      f.classList.toggle('ist-abend', !x.isIntersecting && x.boundingClientRect.top < 0);
    }).observe(m);
  })();
</script>
