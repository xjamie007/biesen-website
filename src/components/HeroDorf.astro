---
/**
 * Bild im Hero: ein gezeichnetes Stück Ösling zur blauen Stunde mit allem, wofür Biesen arbeitet:
 * ein Hof mit Stall und Silo, ein Wohnhaus mit Carport und Ladestation, eine Halle mit Photovoltaik
 * auf dem Dach, Straßenlaternen und Pollerleuchten. Beim Laden gehen die Lichter nacheinander an
 * (nur CSS; bei reduzierter Bewegung sind sie sofort an).
 * Die Punkte im Bild sind Links auf die fünf Leistungen für Maus und Finger; der Name erscheint beim
 * Überfahren. Für Tastatur und Screenreader stehen dieselben Links als Liste unter dem Text im Hero,
 * deshalb sind die Punkte aria-hidden und nicht per Tab erreichbar. Die Punkte liegen in Prozent über dem Bild, das Bild hat ein festes Seitenverhältnis
 * (1440 × 480), deshalb passen sie bei jeder Breite. Mobil wird nur die rechte Hälfte gezeigt,
 * dort stehen alle Gebäude.
 */
import Icon from './Icon.astro';
import type { Dict } from '@/i18n';
import { path, type Lang, type ServicePage } from '@/i18n/config';
import { LEISTUNG_ICON } from '@/lib/icons';

interface Props {
  lang: Lang;
  t: Dict;
}
const { lang, t } = Astro.props;

/** Punkte: Leistung, Lage in Prozent (links, oben) im Bild */
const punkte: [ServicePage, number, number][] = [
  ['licht', 55.4, 75.5],
  ['installation', 72.4, 61],
  ['hausgeraete', 76.4, 85],
  ['sicherheit', 86.6, 73],
  ['photovoltaik', 93.4, 62.5],
];

const DUNKEL = '#1b2a47';
/** Fenster: x, y, Breite, Höhe, Verzögerung (s) */
const stallFenster = [
  [712, 372, 18, 12, 0.3],
  [738, 372, 18, 12, 0.4],
  [836, 372, 18, 12, 0.5],
  [862, 372, 18, 12, 0.6],
] as const;
const hausFenster = [
  [982, 346, 28, 26, 0.9],
  [1031, 346, 28, 26, 1.1],
  [1080, 346, 28, 26, 0.8],
  [982, 394, 28, 26, 1.3],
  [1080, 394, 28, 26, 1.0],
] as const;
const ferneHaeuser = [
  [300, 352, 34, 22],
  [352, 346, 28, 20],
  [470, 338, 36, 24],
  [560, 334, 30, 20],
] as const;
const laternen = [
  [690, 1.7],
  [940, 1.9],
] as const;
const poller = [
  [1000, 2.2],
  [1062, 2.35],
  [1118, 2.5],
] as const;
const sterne = [
  [120, 40], [260, 90], [410, 30], [520, 120], [690, 60], [820, 26], [960, 96], [1110, 40], [1250, 110], [1380, 54], [60, 170], [1330, 180],
] as const;
---
<div class="dorf">
  <svg class="dorf__bild" viewBox="0 0 1440 480" role="img" aria-label={t.home.bildAlt} focusable="false">
    <defs>
      <radialGradient id="dorf-schein">
        <stop offset="0" stop-color="#ffd36b" stop-opacity="0.9" />
        <stop offset="0.45" stop-color="#ffb84a" stop-opacity="0.32" />
        <stop offset="1" stop-color="#ffb84a" stop-opacity="0" />
      </radialGradient>
      <linearGradient id="dorf-kegel" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#ffe08a" stop-opacity="0.55" />
        <stop offset="1" stop-color="#ffe08a" stop-opacity="0" />
      </linearGradient>
      <linearGradient id="dorf-dunst" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#3f6fae" stop-opacity="0" />
        <stop offset="1" stop-color="#3f6fae" stop-opacity="0.35" />
      </linearGradient>
      <filter id="dorf-weich" x="-60%" y="-60%" width="220%" height="220%">
        <feGaussianBlur stdDeviation="7" />
      </filter>
    </defs>

    <g fill="#ffffff">
      {sterne.map(([x, y], i) => <circle class="dorf__stern" cx={x} cy={y} r={i % 3 === 0 ? 1.8 : 1.2} style={`--d:${(i % 5) * 0.7}s`} />)}
    </g>

    {/* Hügel des Ösling, hinten mit Wald, dazwischen Dunst */}
    <path d="M0 372 C200 336 380 344 560 326 C760 306 900 262 1080 250 C1240 240 1360 260 1440 268 L1440 480 L0 480 Z" fill="#17375f" />
    <rect x="0" y="240" width="1440" height="240" fill="url(#dorf-dunst)" />
    <g fill="#12305a">
      <path d="M830 282 l12 -30 l12 30 Z M852 278 l11 -26 l11 26 Z M1150 252 l13 -32 l13 32 Z M1174 250 l12 -28 l12 28 Z M1198 252 l12 -30 l12 30 Z M1290 252 l11 -26 l11 26 Z M1312 256 l13 -30 l13 30 Z M1385 262 l12 -28 l12 28 Z M60 360 l12 -28 l12 28 Z M84 356 l11 -24 l11 24 Z" />
    </g>
    {
      ferneHaeuser.map(([x, y, w, h], i) => (
        <g>
          <rect x={x} y={y} width={w} height={h} fill="#1f3a63" />
          <path d={`M${x - 3} ${y} L${x + w / 2} ${y - h * 0.7} L${x + w + 3} ${y} Z`} fill="#142a4b" />
          <rect class="dorf__an" x={x + w / 2 - 3} y={y + h / 2 - 3} width="6" height="6" fill={DUNKEL} style={`--d:${0.2 + i * 0.25}s`} />
        </g>
      ))
    }
    <path d="M0 420 C240 398 420 404 620 392 C820 378 1000 360 1200 362 C1320 363 1400 372 1440 376 L1440 480 L0 480 Z" fill="#10294b" />

    {/* Bäume zwischen Weg und Hof; links bleibt der Boden frei für die Liste der Leistungen */}
    <g fill="#0d2342">
      <rect x="654" y="392" width="7" height="44" />
      <circle cx="657" cy="384" r="22" />
      <path d="M40 420 l14 -46 l14 46 Z M64 422 l11 -36 l11 36 Z" />
    </g>

    {/* Hof: Stall mit Mansarddach und Silo */}
    <g>
      <rect x="700" y="360" width="180" height="82" fill="#2a3e62" />
      <path d="M690 362 L722 318 L790 300 L858 318 L890 362 Z" fill="#0c1628" />
      <rect x="764" y="390" width="52" height="52" fill="#1e2f4f" />
      <path d="M764 390 l52 52 M816 390 l-52 52" stroke="#2f4670" stroke-width="3" />
      {stallFenster.map(([x, y, w, h, d]) => <rect class="dorf__an" x={x} y={y} width={w} height={h} rx="2" fill={DUNKEL} style={`--d:${d}s`} />)}
      <rect class="dorf__schein" x="700" y="356" width="180" height="34" rx="12" fill="#ffd36b" filter="url(#dorf-weich)" style="--d:0.4s" />
      <rect x="896" y="296" width="38" height="146" fill="#33486d" />
      <path d="M896 296 a19 14 0 0 1 38 0 Z" fill="#40587f" />
      <path d="M896 330 h38 M896 370 h38 M896 410 h38" stroke="#2a3d5f" stroke-width="2" />
    </g>

    {/* Wohnhaus mit Schieferdach */}
    <g>
      <rect x="1084" y="270" width="16" height="40" fill="#0b1526" />
      <rect x="965" y="330" width="160" height="112" fill="#33476b" />
      <path d="M952 334 L1045 264 L1138 334 Z" fill="#0b1526" />
      {hausFenster.map(([x, y, w, h, d]) => (
        <g>
          <rect class="dorf__schein" x={x - 8} y={y - 8} width={w + 16} height={h + 16} rx="8" fill="#ffd36b" filter="url(#dorf-weich)" style={`--d:${d}s`} />
          <rect class="dorf__an" x={x} y={y} width={w} height={h} rx="2" fill={DUNKEL} style={`--d:${d}s`} />
          <path d={`M${x + w / 2} ${y} v${h} M${x} ${y + h / 2} h${w}`} stroke="#33476b" stroke-width="2.5" />
        </g>
      ))}
      <rect class="dorf__an" x="1033" y="386" width="24" height="56" rx="2" fill={DUNKEL} style="--d:1.5s" />
      <path class="dorf__schein" d="M972 442 L962 360 L992 360 Z" fill="url(#dorf-kegel)" style="--d:1.8s" />
      <path class="dorf__schein" d="M1118 442 L1128 360 L1098 360 Z" fill="url(#dorf-kegel)" style="--d:1.8s" />
    </g>

    {/* Carport mit Auto und Ladestation */}
    <g>
      <path d="M1136 380 h88" stroke="#0b1526" stroke-width="6" stroke-linecap="round" />
      <path d="M1140 380 v62 M1220 380 v62" stroke="#22365a" stroke-width="4" />
      <path d="M1148 440 v-14 q0 -10 10 -12 l10 -12 q4 -4 10 -4 h18 q6 0 10 5 l8 11 q8 2 8 10 v16 Z" fill="#1b2c4b" />
      <rect x="1203" y="398" width="10" height="18" rx="2" fill="#2d446c" />
      <circle class="dorf__led" cx="1208" cy="404" r="2.4" fill="#5fe08a" style="--d:2.6s" />
    </g>

    {/* Halle mit Photovoltaik auf dem Dach */}
    <g>
      <rect x="1240" y="330" width="210" height="112" fill="#263a5e" />
      <path d="M1236 332 h214" stroke="#0b1526" stroke-width="6" />
      {
        Array.from({ length: 7 }, (_, i) => 1252 + i * 27).map((x) => (
          <path d={`M${x} 328 l12 -13 h20 l-12 13 Z`} fill="#1d3d72" stroke="#5a86c8" stroke-width="1.2" />
        ))
      }
      <rect x="1296" y="378" width="62" height="64" fill="#1c2c4a" />
      <path d="M1296 392 h62 M1296 406 h62 M1296 420 h62" stroke="#2c416a" stroke-width="2" />
      <rect class="dorf__an" x="1378" y="352" width="58" height="18" rx="2" fill={DUNKEL} style="--d:2.0s" />
      <rect x="1244" y="340" width="12" height="7" rx="2" fill="#4a5f86" />
      <path class="dorf__schein" d="M1250 346 L1226 442 L1290 442 Z" fill="url(#dorf-kegel)" style="--d:2.1s" />
      <circle class="dorf__led" cx="1253" cy="343.5" r="1.6" fill="#ffd36b" style="--d:2.1s" />
    </g>

    {/* Straße mit Laternen */}
    <path d="M0 470 C400 458 900 452 1440 460 L1440 480 L0 480 Z" fill="#0a1d3b" />
    <path d="M0 474 C400 463 900 458 1440 466" stroke="#2a4a78" stroke-width="2" stroke-dasharray="18 16" fill="none" />
    {
      laternen.map(([x, d]) => (
        <g>
          <ellipse class="dorf__schein" cx={x} cy="462" rx="54" ry="10" fill="url(#dorf-schein)" style={`--d:${d}s`} />
          <path class="dorf__schein" d={`M${x} 382 L${x - 34} 462 L${x + 34} 462 Z`} fill="url(#dorf-kegel)" style={`--d:${d}s`} />
          <path d={`M${x} 462 V378 q0 -8 -10 -8 h-10`} stroke="#22385e" stroke-width="4" fill="none" />
          <rect class="dorf__an" x={x - 26} y="368" width="14" height="6" rx="2" fill={DUNKEL} style={`--d:${d}s`} />
        </g>
      ))
    }

    {/* Pollerleuchten am Weg zum Haus */}
    <path d="M1036 442 C1030 452 1018 460 1006 468 L1086 468 C1074 460 1062 452 1056 442 Z" fill="#20345a" />
    {
      poller.map(([x, d]) => (
        <g>
          <ellipse class="dorf__schein" cx={x} cy="452" rx="20" ry="6" fill="url(#dorf-schein)" style={`--d:${d}s`} />
          <rect x={x - 3} y="436" width="6" height="16" rx="1.5" fill="#22385e" />
          <rect class="dorf__an" x={x - 3} y="436" width="6" height="4" rx="1.5" fill={DUNKEL} style={`--d:${d}s`} />
        </g>
      ))
    }
  </svg>

  <ul class="dorf__punkte" aria-hidden="true">
    {
      punkte.map(([p, x, y], i) => (
        <li class:list={['punkt', `farbe--${p}`, x > 85 && 'punkt--rechts']} style={`left:${x}%;top:${y}%;--d:${2.6 + i * 0.15}s`}>
          <a class="punkt__link" href={path(lang, p)} tabindex="-1">
            <span class="punkt__kreis" aria-hidden="true">
              <Icon name={LEISTUNG_ICON[p]} size={18} />
            </span>
            <span class="punkt__name">{t.leistungen[p].name}</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>
