---
/**
 * Ein Foto als AVIF/WebP in mehreren Breiten, mit width/height im Markup.
 * Fehlt die Datei, steht an derselben Stelle eine Fläche in Kalkputz: „Foto folgt: [Motiv]“.
 * Radius 0, keine Abdunklung, kein Text auf dem Foto.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { fmt } from '@/i18n';

interface Props {
  bild: ImageMetadata | null;
  alt: string;
  /** Text des Platzhalters, z. B. „Foto folgt: Milchviehstall“ */
  folgt: string;
  motiv: string;
  format?: '3-2' | '4-5' | '1-1';
  sizes: string;
  loading?: 'lazy' | 'eager';
  class?: string;
  fokus?: string;
}
const { bild, alt, folgt, motiv, format = '3-2', sizes, loading = 'lazy', class: klasse = '', fokus } = Astro.props;
const breiten = [480, 768, 1080, 1600, 2000];
---
<figure class:list={['foto', `foto--${format}`, klasse]}>
  {
    bild ? (
      <Picture
        src={bild}
        alt={alt}
        formats={['avif', 'webp']}
        widths={breiten.filter((w) => w <= bild.width)}
        sizes={sizes}
        loading={loading}
        decoding="async"
        style={fokus ? `object-position:${fokus}` : undefined}
      />
    ) : (
      <div class="platzhalter" role="img" aria-label={fmt(folgt, { motiv })}>
        <span aria-hidden="true">{fmt(folgt, { motiv })}</span>
      </div>
    )
  }
  <slot />
</figure>
