---
/**
 * Gemeinsamer Rahmen der Leistungsseiten (D3): Seitenkopf mit Symbol, h1, Einleitung, ein breites
 * Foto (bis eigene Fotos da sind: Symbolbild aus src/lib/stock.ts), Inhalt (Slot),
 * passende Projekte, passende Fragen, die anderen vier Leistungen als Karten und der Abschluss
 * „Anrufen oder schreiben“ mit vorgewähltem Anliegen.
 * JSON-LD: Service (provider = Firma), BreadcrumbList, FAQPage (nur Fragen ohne offene Punkte).
 */
import Base from '@/layouts/Base.astro';
import Seitenkopf from './Seitenkopf.astro';
import ProjektEintrag from './ProjektEintrag.astro';
import Faq from './Faq.astro';
import Aufruf from './Aufruf.astro';
import Icon from './Icon.astro';
import Leistungskarte from './Leistungskarte.astro';
import Foto from './Foto.astro';
import { rich, stripOpenPoints, useT } from '@/i18n';
import { path, SERVICE_PAGES, type Lang, type ServicePage } from '@/i18n/config';
import { breadcrumbs, faqPage, service } from '@/lib/jsonld';
import { faqJsonItems, type FaqKey } from '@/lib/faq';
import { paarFuer, projekteNachArt, type Art } from '@/lib/projekte';
import { LEISTUNG_ICON } from '@/lib/icons';
import { STOCK, STOCK_FOKUS, STOCK_SEITE } from '@/lib/stock';

interface Props {
  lang: Lang;
  page: ServicePage;
  h1: string;
  intro: string;
  anliegen: string;
  arten: readonly Art[];
  faq: readonly FaqKey[];
  serviceType: string;
  /** Projekte zeigt die Seite selbst (Lichtseite: in den Bereichen) */
  ohneProjekte?: boolean;
}
const { lang, page, h1, intro, anliegen, arten, faq, serviceType, ohneProjekte = false } = Astro.props;
const t = useT(lang);
const pfad = [
  { name: t.nav.home, href: path(lang, 'home') },
  { name: t.nav.leistungen, href: path(lang, 'leistungen') },
  { name: t.leistungen[page].name, href: path(lang, page) },
];
const projekte = ohneProjekte ? [] : await projekteNachArt(arten);
const testTexte = { tag: t.owend.testTag, abend: t.owend.testAbend };
const paare = await Promise.all(projekte.map((p) => (p.data.owend ? paarFuer(p, lang, testTexte) : Promise.resolve(null))));
const faqItems = faqJsonItems(t, faq);
const jsonld = [
  service({ name: t.leistungen[page].name, description: stripOpenPoints(intro), url: path(lang, page), serviceType }),
  breadcrumbs(pfad.map((p) => ({ name: p.name, url: p.href }))),
  ...(faqItems.length ? [faqPage(faqItems)] : []),
];
const seo = t.seo[page];
const seitenFoto = STOCK_SEITE[page];
---
<Base lang={lang} route={{ page }} title={seo.title} description={seo.description} jsonld={jsonld}>
  <Seitenkopf pfadLabel={t.a11y.pfad} pfad={pfad} h1={h1} intro={intro} icon={LEISTUNG_ICON[page]} farbe={page} />

  {
    seitenFoto && (
      <div class="raster seitenfoto">
        <Foto
          class="seitenfoto__bild"
          bild={STOCK[seitenFoto]}
          alt={t.stock[seitenFoto]}
          folgt={t.allgemein.fotoFolgt}
          motiv={t.leistungen[page].name}
          format="breit"
          fokus={STOCK_FOKUS[seitenFoto]}
          hinweis={t.allgemein.symbolbild}
          loading="eager"
          sizes="(min-width: 1024px) 1240px, 100vw"
        />
      </div>
    )
  }

  <slot />

  {
    !ohneProjekte && (
      <section class="sektion" aria-labelledby="projekte-h">
        <div class="raster">
          <h2 id="projekte-h" class="sektion__kopf">{t.allgemein.passendeProjekte}</h2>
        </div>
        {projekte.length > 0 ? (
          <div class="gruppe__liste">
            {projekte.map((p, i) => (
              <ProjektEintrag lang={lang} t={t} projekt={p} variante="liste" paar={paare[i]} />
            ))}
          </div>
        ) : (
          <div class="raster">
            <p set:html={rich(t.allgemein.projekteFehlen)} />
          </div>
        )}
      </section>
    )
  }

  {
    faq.length > 0 && (
      <section class="sektion" aria-labelledby="fragen-h">
        <div class="raster">
          <div>
            <h2 id="fragen-h" class="sektion__kopf">{t.allgemein.passendeFragen}</h2>
            <Faq lang={lang} t={t} keys={faq} />
          </div>
        </div>
      </section>
    )
  }

  <section class="sektion" aria-labelledby="weitere-h">
    <div class="raster">
      <h2 id="weitere-h" class="sektion__kopf">{t.nav.leistungen}</h2>
      <ul class="karten karten--kompakt">
        {SERVICE_PAGES.filter((p) => p !== page).map((p) => <Leistungskarte lang={lang} t={t} page={p} punkte={0} class="zeigen" />)}
      </ul>
      <p class="sektion__fuss">
        <a class="textlink" href={path(lang, 'leistungen')}>
          {t.nav.alleLeistungen}
          <Icon name="pfeil" size={20} />
        </a>
      </p>
    </div>
  </section>

  <Aufruf lang={lang} t={t} titel={t.home.kontaktH2} anliegen={anliegen}>
    <slot name="aktion" />
  </Aufruf>
</Base>
