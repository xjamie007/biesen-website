---
/**
 * Startseite (D2), in dieser Reihenfolge:
 * Hero mit dem gezeichneten Dorf (Lichter gehen an, Punkte führen zu den Leistungen), Fakten,
 * Leistungen als Karten, Bei Tag und am Abend (Regler), Weg zum Angebot, Wo wir gearbeitet haben,
 * 26 Leute in Noutem mit offenen Stellen, Marken und Mitgliedschaften, Häufige Fragen,
 * Anrufen oder schreiben, Fuß.
 */
import Base from '@/layouts/Base.astro';
import HeroDorf from '@/components/HeroDorf.astro';
import TagAbend from '@/components/TagAbend.astro';
import Foto from '@/components/Foto.astro';
import Icon from '@/components/Icon.astro';
import Leistungskarte from '@/components/Leistungskarte.astro';
import ProjektEintrag from '@/components/ProjektEintrag.astro';
import Faq from '@/components/Faq.astro';
import AnrufenSchreiben from '@/components/AnrufenSchreiben.astro';
import { rich, typo, useT } from '@/i18n';
import { path, pathFor, SERVICE_PAGES, type Lang } from '@/i18n/config';
import { faqJsonItems, FAQ_KEYS } from '@/lib/faq';
import { faqPage } from '@/lib/jsonld';
import { LEISTUNG_ICON } from '@/lib/icons';
import { MARKEN } from '@/lib/leistungen';
import { heroPaar, startseitenProjekte } from '@/lib/projekte';
import { projektBild } from '@/lib/bilder';
import { jobRoute, offeneJobs } from '@/lib/jobs';
import { getEntry } from 'astro:content';
import { site, telHref, DEV } from '@/lib/site';
import { kurzText } from '@/lib/zeiten';
import { withBase } from '@/i18n/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const testTexte = { tag: t.owend.testTag, abend: t.owend.testAbend };
const paar = await heroPaar(lang, testTexte, t.owend.motivStartseite);
const projekte = await startseitenProjekte();
const jobs = await offeneJobs();

/** Fotos der Leistungskarten: aus freigegebenen Projekten, sonst ohne Foto */
async function leistungsFoto(id: string, index = 0) {
  const p = await getEntry('projekte', id);
  if (!p || (!DEV && !p.data.freigabe)) return null;
  const f = p.data.fotos[index];
  return f ? { bild: projektBild(f.bild), alt: f.alt[lang] } : null;
}
const fotos = {
  installation: await leistungsFoto('fertighaus-module'),
  licht: await leistungsFoto('milchviehstall'),
};

/** „26 Leute in Noutem“: die Zahl wird groß gesetzt, der Rest bleibt die Überschrift */
const [teamZahl, ...teamRest] = t.home.teamH2.split(' ');
const teamMitZahl = /^\d+$/.test(teamZahl);
const u = t.seiten.ueberUns;
const ablauf = t.seiten.leistungen;

const ogBild =
  paar.bilder && !paar.test && paar.freigegeben
    ? { src: withBase('/og/startseite.png'), width: 1200, height: 630, alt: paar.bilder.abend.alt }
    : undefined;
---
<Base
  lang={lang}
  route={{ page: 'home' }}
  title={t.seo.home.title}
  description={t.seo.home.description}
  ogBild={ogBild}
  jsonld={faqJsonItems(t, FAQ_KEYS).length ? [faqPage(faqJsonItems(t, FAQ_KEYS))] : []}
>
  <section class="hero" aria-labelledby="hero-titel">
    <div class="raster hero__oben">
      <div class="hero__titel">
        <p class="eyebrow eyebrow--hell auftritt"><Icon name="blitz" size={16} />{t.meta.ogAlt}</p>
        <h1 id="hero-titel" class="auftritt">{t.home.h1}</h1>
      </div>
      <div class="hero__seite">
        <p class="lead auftritt">{t.home.lead}</p>
        <p class="hero__aktionen auftritt">
          <a class="knopf knopf--giel" href={path(lang, 'kontakt')}>
            {t.allgemein.angebotAnfragen}
            <Icon name="pfeil" size={20} />
          </a>
          <a class="knopf knopf--rand" href={telHref}>
            <Icon name="telefon" size={20} />
            <span class="sr-only">{t.allgemein.telefon} </span><span class="zahl">{site.telefon.anzeige}</span>
          </a>
        </p>
      </div>
    </div>
    <div class="hero__unten">
      <HeroDorf lang={lang} t={t} />
      <div class="raster hero__leistungen-raster">
        <nav class="hero__leistungen auftritt" aria-labelledby="hero-leistungen-h">
          <p id="hero-leistungen-h" class="label label--hell">{t.nav.leistungen}</p>
          <ul class="chips">
            {
              SERVICE_PAGES.map((p) => (
                <li>
                  <a class:list={['chip', 'chip--hell', `farbe--${p}`]} href={path(lang, p)} data-punkt={p}>
                    <Icon name={LEISTUNG_ICON[p]} size={18} />
                    {t.leistungen[p].name}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </div>
  </section>

  <section class="fakten" aria-label={t.nav.ueberUns}>
    <div class="raster">
      <ul class="fakten__liste">
        <li class="fakt">
          <span class="fakt__symbol farbe--installation" aria-hidden="true"><Icon name="team" size={26} /></span>
          <p><strong class="fakt__wert zahl">{site.mitarbeitende}</strong> <span>{t.home.fakten.leute}</span></p>
        </li>
        <li class="fakt">
          <span class="fakt__symbol farbe--licht" aria-hidden="true"><Icon name="blitz" size={26} /></span>
          <p><strong class="fakt__wert zahl">{SERVICE_PAGES.length}</strong> <span>{t.home.fakten.bereiche}</span></p>
        </li>
        <li class="fakt">
          <span class="fakt__symbol farbe--photovoltaik" aria-hidden="true"><Icon name="ort" size={26} /></span>
          <p><strong class="fakt__wert">{t.home.fakten.ortTitel}</strong> <span>{t.home.fakten.ort}</span></p>
        </li>
        <li class="fakt">
          <span class="fakt__symbol farbe--hausgeraete" aria-hidden="true"><Icon name="telefon" size={26} /></span>
          <p>
            <a class="fakt__wert zahl" href={telHref}><span class="sr-only">{t.allgemein.telefon} </span>{site.telefon.anzeige}</a>
            <span class="zahl">{kurzText(t)}</span>
          </p>
        </li>
      </ul>
    </div>
  </section>

  <section class="sektion" id="leistungen" aria-labelledby="leistungen-h">
    <div class="raster">
      <div class="sektion__kopf">
        <p class="eyebrow"><Icon name="blitz" size={16} />{t.nav.leistungen}</p>
        <h2 id="leistungen-h">{t.home.leistungenH2}</h2>
        <p class="lead sektion__lead">{t.home.leistungenIntro}</p>
      </div>
      <ul class="karten">
        {
          SERVICE_PAGES.map((p) => {
            const foto = p === 'installation' || p === 'licht' ? fotos[p] : null;
            return (
              <Leistungskarte lang={lang} t={t} page={p} class="zeigen">
                {foto && (
                  <Foto
                    slot="foto"
                    class="karte__foto"
                    bild={foto.bild}
                    alt={foto.alt}
                    folgt={t.allgemein.fotoFolgt}
                    motiv={t.leistungen[p].name}
                    sizes="(min-width: 1024px) 40vw, 100vw"
                  />
                )}
              </Leistungskarte>
            );
          })
        }
      </ul>
      <p class="sektion__fuss">
        <a class="knopf knopf--hell" href={path(lang, 'leistungen')}>
          {t.home.alleLeistungen}
          <Icon name="pfeil" size={20} />
        </a>
      </p>
    </div>
  </section>

  <TagAbend lang={lang} t={t} paar={paar} />

  <section class="sektion flaeche flaeche--warm" aria-labelledby="weg-h">
    <div class="raster">
      <div>
        <h2 id="weg-h" class="sektion__kopf">{ablauf.ablaufH2}</h2>
        <ol class="schritte">
          {ablauf.ablauf.map((x) => <li class="schritt zeigen">{x}</li>)}
        </ol>
        <p class="klein schritte__hinweis" set:html={rich(ablauf.ablaufHinweis)} />
        <p class="sektion__fuss">
          <a class="knopf" href={path(lang, 'kontakt')}>
            {t.allgemein.angebotAnfragen}
            <Icon name="pfeil" size={20} />
          </a>
        </p>
      </div>
    </div>
  </section>

  <section class="sektion" aria-labelledby="projekte-h">
    <div class="raster">
      <div class="sektion__kopf">
        <p class="eyebrow"><Icon name="blitz" size={16} />{t.nav.projekte}</p>
        <h2 id="projekte-h">{t.home.projekteH2}</h2>
      </div>
    </div>
    {
      projekte.length > 0 ? (
        <div class="projekte">
          {projekte.map((p, i) => (
            <ProjektEintrag lang={lang} t={t} projekt={p} variante="startseite" seite={i % 2 === 0 ? 'rechts' : 'links'} />
          ))}
        </div>
      ) : (
        <div class="raster">
          <p class="hinweisflaeche" set:html={rich(t.allgemein.projekteFehlen)} />
        </div>
      )
    }
    <div class="raster">
      <p class="sektion__fuss">
        <a class="textlink" href={path(lang, 'projekte')}>
          {t.home.alleProjekte}
          <Icon name="pfeil" size={20} />
        </a>
      </p>
    </div>
  </section>

  <section class="sektion flaeche" aria-labelledby="team-h">
    <div class="raster team">
      <div class="team__text zeigen">
        <p class="eyebrow"><Icon name="blitz" size={16} />{t.nav.ueberUns}</p>
        <h2 id="team-h" class="team__titel">
          {
            teamMitZahl ? (
              <>
                <span class="team__zahl zahl">{teamZahl}</span> <span>{teamRest.join(' ')}</span>
              </>
            ) : (
              t.home.teamH2
            )
          }
        </h2>
        <div class="prosa sektion__text">
          <p>{t.home.team}</p>
          <p set:html={rich(t.home.teamLeitung)} />
        </div>
        {
          jobs.length > 0 && (
            <div class="team__jobs">
              <p class="label">{t.seiten.jobs.offenH2}</p>
              <ul class="jobliste">
                {jobs.map((j) => (
                  <li>
                    <a class="jobkarte" href={pathFor(lang, jobRoute(j))}>
                      <span class="symbol symbol--klein" aria-hidden="true">
                        <Icon name="team" size={20} />
                      </span>
                      <span class="jobkarte__text">
                        <span class="jobkarte__titel">{j.data.titel[lang]}</span>
                        <span class="jobkarte__kurz">{typo(lang, j.data.kurz[lang])}</span>
                      </span>
                      <Icon name="pfeil" size={20} />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        <p class="sektion__text">
          {t.home.jobs} <a href={path(lang, 'jobs')}>{t.home.jobsLink}</a>
        </p>
      </div>
      <Foto class="team__foto zeigen" bild={null} alt="" folgt={t.allgemein.fotoFolgt} motiv={t.home.teamFoto} sizes="(min-width: 1024px) 50vw, 100vw" />
    </div>
  </section>

  <section class="sektion marken" aria-labelledby="marken-h">
    <div class="raster">
      <div class="marken__inhalt">
        <h2 id="marken-h" class="sektion__kopf">{t.home.markenH2}</h2>
        <div class="marken__gruppe">
          <p class="label">{t.home.marken}</p>
          <ul class="marken__liste">
            {MARKEN.map((m) => <li class="marke">{m}</li>)}
          </ul>
        </div>
        <div class="marken__gruppe">
          <p class="label">{u.mitgliedH2}</p>
          <ul class="stichpunkte stichpunkte--gross">
            {u.mitglied.map((m) => <li>{m}</li>)}
          </ul>
          <p class="klein marken__hinweis" set:html={rich(u.mitgliedHinweis)} />
        </div>
      </div>
    </div>
  </section>

  <section class="sektion flaeche" aria-labelledby="faq-h">
    <div class="raster">
      <div>
        <h2 id="faq-h" class="sektion__kopf">{t.home.faqH2}</h2>
        <Faq lang={lang} t={t} keys={FAQ_KEYS} />
      </div>
    </div>
  </section>

  <AnrufenSchreiben lang={lang} t={t} />
</Base>
