---
/**
 * Startseite (D2), in dieser Reihenfolge:
 * Hero in Blaue-Stunde-Blau mit Owend, Leistungen als Karten, Wo wir gearbeitet haben,
 * 26 Leute in Noutem, Häufige Fragen, Anrufen oder schreiben, Fuß.
 */
import Base from '@/layouts/Base.astro';
import Owend from '@/components/Owend.astro';
import Foto from '@/components/Foto.astro';
import Icon from '@/components/Icon.astro';
import Leistungskarte from '@/components/Leistungskarte.astro';
import ProjektEintrag from '@/components/ProjektEintrag.astro';
import Faq from '@/components/Faq.astro';
import AnrufenSchreiben from '@/components/AnrufenSchreiben.astro';
import { rich, useT } from '@/i18n';
import { path, SERVICE_PAGES, type Lang } from '@/i18n/config';
import { faqJsonItems, FAQ_KEYS } from '@/lib/faq';
import { faqPage } from '@/lib/jsonld';
import { LEISTUNG_ICON } from '@/lib/icons';
import { heroPaar, startseitenProjekte } from '@/lib/projekte';
import { projektBild } from '@/lib/bilder';
import { getEntry } from 'astro:content';
import { site, telHref, DEV } from '@/lib/site';
import { withBase } from '@/i18n/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const testTexte = { tag: t.owend.testTag, abend: t.owend.testAbend };
const paar = await heroPaar(lang, testTexte, t.owend.motivStartseite);
const projekte = await startseitenProjekte();

/** Fotos der Leistungskarten: aus freigegebenen Projekten, sonst ohne Foto */
async function leistungsFoto(id: string, index = 0) {
  const p = await getEntry('projekte', id);
  if (!p || (!DEV && !p.data.freigabe)) return null;
  const f = p.data.fotos[index];
  return f ? { bild: projektBild(f.bild), alt: f.alt[lang] } : null;
}
const fotos = {
  installation: await leistungsFoto('fertighaus-module'),
  licht: await leistungsFoto('milchviehstall'),
};

/** „26 Leute in Noutem“: die Zahl wird groß gesetzt, der Rest bleibt die Überschrift */
const [teamZahl, ...teamRest] = t.home.teamH2.split(' ');
const teamMitZahl = /^\d+$/.test(teamZahl);

const ogBild =
  paar.bilder && !paar.test && paar.freigegeben
    ? { src: withBase('/og/startseite.png'), width: 1200, height: 630, alt: paar.bilder.abend.alt }
    : undefined;
---
<Base
  lang={lang}
  route={{ page: 'home' }}
  title={t.seo.home.title}
  description={t.seo.home.description}
  ogBild={ogBild}
  jsonld={faqJsonItems(t, FAQ_KEYS).length ? [faqPage(faqJsonItems(t, FAQ_KEYS))] : []}
>
  <section class="raster hero" aria-labelledby="hero-titel">
    <div class="hero__text">
      <p class="eyebrow eyebrow--hell auftritt"><Icon name="blitz" size={16} />{t.meta.ogAlt}</p>
      <h1 id="hero-titel" class="auftritt">{t.home.h1}</h1>
      <p class="lead auftritt">{t.home.lead}</p>
      <p class="hero__aktionen auftritt">
        <a class="knopf knopf--giel" href={path(lang, 'kontakt')}>
          {t.allgemein.angebotAnfragen}
          <Icon name="pfeil" size={20} />
        </a>
        <a class="knopf knopf--rand" href={telHref}>
          <Icon name="telefon" size={20} />
          <span class="sr-only">{t.allgemein.telefon} </span><span class="zahl">{site.telefon.anzeige}</span>
        </a>
      </p>
      <nav class="hero__leistungen auftritt" aria-labelledby="hero-leistungen-h">
        <p id="hero-leistungen-h" class="label label--hell">{t.nav.leistungen}</p>
        <ul class="chips">
          {
            SERVICE_PAGES.map((p) => (
              <li>
                <a class="chip chip--hell" href={path(lang, p)}>
                  <Icon name={LEISTUNG_ICON[p]} size={18} />
                  {t.leistungen[p].name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
    <Owend t={t} paar={paar} />
  </section>

  <section class="sektion" id="leistungen" aria-labelledby="leistungen-h">
    <div class="raster">
      <div class="sektion__kopf">
        <p class="eyebrow"><Icon name="blitz" size={16} />{t.nav.leistungen}</p>
        <h2 id="leistungen-h">{t.home.leistungenH2}</h2>
        <p class="lead sektion__lead">{t.home.leistungenIntro}</p>
      </div>
      <ul class="karten">
        {
          SERVICE_PAGES.map((p) => {
            const foto = p === 'installation' || p === 'licht' ? fotos[p] : null;
            return (
              <Leistungskarte lang={lang} t={t} page={p} class="zeigen">
                {foto && (
                  <Foto
                    slot="foto"
                    class="karte__foto"
                    bild={foto.bild}
                    alt={foto.alt}
                    folgt={t.allgemein.fotoFolgt}
                    motiv={t.leistungen[p].name}
                    sizes="(min-width: 1024px) 40vw, 100vw"
                  />
                )}
              </Leistungskarte>
            );
          })
        }
      </ul>
      <p class="sektion__fuss">
        <a class="knopf knopf--hell" href={path(lang, 'leistungen')}>
          {t.home.alleLeistungen}
          <Icon name="pfeil" size={20} />
        </a>
      </p>
    </div>
  </section>

  <section class="sektion" aria-labelledby="projekte-h">
    <div class="raster">
      <div class="sektion__kopf">
        <p class="eyebrow"><Icon name="blitz" size={16} />{t.nav.projekte}</p>
        <h2 id="projekte-h">{t.home.projekteH2}</h2>
      </div>
    </div>
    {
      projekte.length > 0 ? (
        <div class="projekte">
          {projekte.map((p, i) => (
            <ProjektEintrag lang={lang} t={t} projekt={p} variante="startseite" seite={i % 2 === 0 ? 'rechts' : 'links'} />
          ))}
        </div>
      ) : (
        <div class="raster">
          <p class="hinweisflaeche" set:html={rich(t.allgemein.projekteFehlen)} />
        </div>
      )
    }
    <div class="raster">
      <p class="sektion__fuss">
        <a class="textlink" href={path(lang, 'projekte')}>
          {t.home.alleProjekte}
          <Icon name="pfeil" size={20} />
        </a>
      </p>
    </div>
  </section>

  <section class="sektion flaeche" aria-labelledby="team-h">
    <div class="raster team">
      <div class="team__text zeigen">
        <p class="eyebrow"><Icon name="blitz" size={16} />{t.nav.ueberUns}</p>
        <h2 id="team-h" class="team__titel">
          {
            teamMitZahl ? (
              <>
                <span class="team__zahl zahl">{teamZahl}</span> <span>{teamRest.join(' ')}</span>
              </>
            ) : (
              t.home.teamH2
            )
          }
        </h2>
        <div class="prosa sektion__text">
          <p>{t.home.team}</p>
          <p set:html={rich(t.home.teamLeitung)} />
          <p>
            {t.home.jobs} <a href={path(lang, 'jobs')}>{t.home.jobsLink}</a>
          </p>
        </div>
      </div>
      <Foto class="team__foto zeigen" bild={null} alt="" folgt={t.allgemein.fotoFolgt} motiv={t.home.teamFoto} sizes="(min-width: 1024px) 50vw, 100vw" />
    </div>
  </section>

  <section class="sektion" aria-labelledby="faq-h">
    <div class="raster">
      <div>
        <h2 id="faq-h" class="sektion__kopf">{t.home.faqH2}</h2>
        <Faq lang={lang} t={t} keys={FAQ_KEYS} />
      </div>
    </div>
  </section>

  <AnrufenSchreiben lang={lang} t={t} />
</Base>
