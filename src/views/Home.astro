---
/**
 * Startseite (D2). Ziel: In 15 Sekunden ist klar, wer Biesen ist, was der Betrieb macht, wo er
 * arbeitet und wie man ihn erreicht. Reihenfolge:
 * 1. Hero: „Ihr Elektriker im Norden Luxemburgs“, alle Leistungen in einem Satz, Anfrage und
 *    Telefon, darunter die fünf Leistungen als Kacheln (mobil in zwei Spalten), dann zwei Fakten.
 * 2. Laufband mit den Leistungen.
 * 3. Die Leistungen ausführlich (Karten).
 * 4. Über uns: ein Satz, der beim Scrollen Wort für Wort aufleuchtet, Zahlen, offene Stellen.
 * 5. Weg zum Angebot in vier Schritten mit Fortschrittslinie.
 * 6. Projekte (erst, wenn welche freigegeben sind), Marken und Mitgliedschaften, Fragen, Kontakt.
 */
import Base from '@/layouts/Base.astro';
import Foto from '@/components/Foto.astro';
import Icon from '@/components/Icon.astro';
import Leistungskarte from '@/components/Leistungskarte.astro';
import ProjektEintrag from '@/components/ProjektEintrag.astro';
import Faq from '@/components/Faq.astro';
import AnrufenSchreiben from '@/components/AnrufenSchreiben.astro';
import { rich, stripOpenPoints, typo, useT } from '@/i18n';
import { path, pathFor, SERVICE_PAGES, type Lang } from '@/i18n/config';
import { faqJsonItems, FAQ_KEYS } from '@/lib/faq';
import { faqPage, leistungsKatalog } from '@/lib/jsonld';
import { LEISTUNG_ICON } from '@/lib/icons';
import { kartenPunkte, MARKEN } from '@/lib/leistungen';
import { heroPaar, startseitenProjekte } from '@/lib/projekte';
import { projektBild } from '@/lib/bilder';
import { jobRoute, offeneJobs } from '@/lib/jobs';
import { getEntry } from 'astro:content';
import { site, telHref, DEV } from '@/lib/site';
import { withBase } from '@/i18n/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const testTexte = { tag: t.owend.testTag, abend: t.owend.testAbend };
const paar = await heroPaar(lang, testTexte, t.owend.motivStartseite);
const projekte = await startseitenProjekte();
const jobs = await offeneJobs();

/** Fotos der Leistungskarten: aus freigegebenen Projekten, sonst ohne Foto */
async function leistungsFoto(id: string, index = 0) {
  const p = await getEntry('projekte', id);
  if (!p || (!DEV && !p.data.freigabe)) return null;
  const f = p.data.fotos[index];
  return f ? { bild: projektBild(f.bild), alt: f.alt[lang] } : null;
}
const fotos = {
  installation: await leistungsFoto('fertighaus-module'),
  licht: await leistungsFoto('milchviehstall'),
};

/** Der Satz über den Betrieb, Wort für Wort (leuchtet beim Scrollen auf) */
const woerter = t.home.team.split(' ');

/** Laufband: alle Leistungen und was dazugehört, ohne Dopplungen */
const band = [...new Set(SERVICE_PAGES.flatMap((p) => [t.leistungen[p].name, ...kartenPunkte(t, p).slice(0, 2)]))];

const ablauf = t.seiten.leistungen;
const jsonld = [
  leistungsKatalog(
    t.home.leistungenH2,
    SERVICE_PAGES.map((p) => ({ name: t.leistungen[p].name, description: stripOpenPoints(t.leistungen[p].text), url: path(lang, p) })),
  ),
  ...(faqJsonItems(t, FAQ_KEYS).length ? [faqPage(faqJsonItems(t, FAQ_KEYS))] : []),
];
const ogBild =
  paar.bilder && !paar.test && paar.freigegeben
    ? { src: withBase('/og/startseite.png'), width: 1200, height: 630, alt: paar.bilder.abend.alt }
    : undefined;
---
<Base lang={lang} route={{ page: 'home' }} title={t.seo.home.title} description={t.seo.home.description} ogBild={ogBild} jsonld={jsonld}>
  <section class="hero" aria-labelledby="hero-titel">
    <div class="hero__licht" aria-hidden="true"></div>
    <div class="raster">
      <div class="hero__inhalt">
        <p class="eyebrow eyebrow--pille hero__marke auftritt"><Icon name="blitz" size={16} />{t.meta.ogAlt}</p>
        <h1 id="hero-titel" class="hero__titel">
          {
            t.home.h1.split(' ').map((w, i) => (
              <>
                <span class="hero__wort" style={`--i:${i}`}><span>{w}</span></span>{' '}
              </>
            ))
          }
        </h1>
        <p class="hero__lead auftritt">{t.home.lead}</p>
        <p class="hero__aktionen auftritt">
          <a class="knopf knopf--gross" href={path(lang, 'kontakt')}>
            {t.allgemein.angebotAnfragen}
            <span class="hero__pfeil"><Icon name="pfeil" size={20} /></span>
          </a>
          <a class="knopf knopf--gross knopf--hell" href={telHref}>
            <Icon name="telefon" size={20} />
            <span class="sr-only">{t.allgemein.telefon} </span><span class="zahl">{site.telefon.anzeige}</span>
          </a>
        </p>
      </div>
    </div>

    <div class="raster">
      <nav class="wahl" aria-labelledby="wahl-h">
        <p id="wahl-h" class="wahl__titel">{t.home.wahl}</p>
        <ul class="wahl__liste">
          {
            SERVICE_PAGES.map((p, i) => (
              <li class:list={['kachel', `farbe--${p}`]} style={`--i:${i}`}>
                <a class="kachel__link" href={path(lang, p)} data-licht>
                  <span class="kachel__symbol" aria-hidden="true">
                    <Icon name={LEISTUNG_ICON[p]} size={30} />
                  </span>
                  <span class="kachel__name">{t.leistungen[p].name}</span>
                  <span class="kachel__kurz">{t.leistungen[p].kurz}</span>
                  <span class="kachel__pfeil" aria-hidden="true"><Icon name="pfeil" size={18} /></span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="raster">
      <ul class="hero__fakten auftritt">
        <li><Icon name="team" size={18} /><span><strong class="zahl">{site.mitarbeitende}</strong> {t.home.fakten.leute}</span></li>
        <li><Icon name="ort" size={18} /><span><strong>{t.home.fakten.ortTitel}</strong>, {t.home.fakten.ort}</span></li>
      </ul>
    </div>
  </section>

  <div class="laufband" aria-hidden="true">
    <div class="laufband__spur">
      {
        [0, 1].map(() => (
          <ul class="laufband__liste">
            {band.map((x) => (
              <li>
                <Icon name="blitz" size={18} />
                {x}
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>

  <section class="sektion" id="leistungen" aria-labelledby="leistungen-h">
    <div class="raster">
      <div class="sektion__kopf sektion__kopf--mitte">
        <p class="eyebrow"><Icon name="blitz" size={16} />{t.nav.leistungen}</p>
        <h2 id="leistungen-h">{t.home.leistungenH2}</h2>
        <p class="lead sektion__lead">{t.home.leistungenIntro}</p>
      </div>
      <ul class="karten">
        {
          SERVICE_PAGES.map((p) => {
            const foto = p === 'installation' || p === 'licht' ? fotos[p] : null;
            return (
              <Leistungskarte lang={lang} t={t} page={p} class="zeigen">
                {foto && (
                  <Foto
                    slot="foto"
                    class="karte__foto"
                    bild={foto.bild}
                    alt={foto.alt}
                    folgt={t.allgemein.fotoFolgt}
                    motiv={t.leistungen[p].name}
                    sizes="(min-width: 1024px) 40vw, 100vw"
                  />
                )}
              </Leistungskarte>
            );
          })
        }
      </ul>
      <p class="sektion__fuss sektion__fuss--mitte">
        <a class="knopf knopf--hell" href={path(lang, 'leistungen')}>
          {t.home.alleLeistungen}
          <Icon name="pfeil" size={20} />
        </a>
      </p>
    </div>
  </section>

  <section class="sektion flaeche ueber" aria-labelledby="ueber-h">
    <div class="raster">
      <div class="ueber__inhalt">
        <p class="eyebrow"><Icon name="blitz" size={16} />{t.nav.ueberUns}</p>
        <h2 id="ueber-h" class="sr-only">{t.home.teamH2}</h2>
        <p class="aufleuchten">
          {
            woerter.map((w) => (
              <>
                <span class="aufleuchten__wort">{w}</span>{' '}
              </>
            ))
          }
        </p>
        <ul class="zahlen">
          <li class="zahl-kachel zeigen">
            <span class="zahl-kachel__wert zaehler" style={`--ziel:${site.mitarbeitende}`}><span class="zaehler__text">{site.mitarbeitende}</span></span>
            <span class="zahl-kachel__text">{t.home.fakten.leute}</span>
          </li>
          <li class="zahl-kachel zeigen">
            <span class="zahl-kachel__wert zaehler" style={`--ziel:${SERVICE_PAGES.length}`}><span class="zaehler__text">{SERVICE_PAGES.length}</span></span>
            <span class="zahl-kachel__text">{t.home.fakten.bereiche}</span>
          </li>
          <li class="zahl-kachel zeigen">
            <span class="zahl-kachel__wert">{t.home.fakten.ortTitel}</span>
            <span class="zahl-kachel__text">{t.home.fakten.ort}</span>
          </li>
        </ul>
        {
          jobs.length > 0 && (
            <div class="ueber__jobs">
              <p class="ueber__jobs-titel">
                <strong>{t.home.jobs}</strong> <a href={path(lang, 'jobs')}>{t.home.jobsLink}</a>
              </p>
              <ul class="jobliste">
                {jobs.map((j) => (
                  <li>
                    <a class="jobkarte" href={pathFor(lang, jobRoute(j))}>
                      <span class="symbol symbol--klein" aria-hidden="true">
                        <Icon name="team" size={20} />
                      </span>
                      <span class="jobkarte__text">
                        <span class="jobkarte__titel">{j.data.titel[lang]}</span>
                        <span class="jobkarte__kurz">{typo(lang, j.data.kurz[lang])}</span>
                      </span>
                      <Icon name="pfeil" size={20} />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <section class="sektion weg" aria-labelledby="weg-h">
    <div class="raster">
      <div class="weg__inhalt">
        <div class="weg__kopf">
          <p class="eyebrow"><Icon name="blitz" size={16} />{t.allgemein.angebotAnfragen}</p>
          <h2 id="weg-h">{ablauf.ablaufH2}</h2>
          <p class="klein schritte__hinweis" set:html={rich(ablauf.ablaufHinweis)} />
          <p class="weg__aktion">
            <a class="knopf" href={path(lang, 'kontakt')}>
              {t.allgemein.angebotAnfragen}
              <Icon name="pfeil" size={20} />
            </a>
          </p>
        </div>
        <ol class="weg__schritte">
          {
            ablauf.ablauf.map((x) => (
              <li class="weg__schritt">
                <span>{x}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  {
    projekte.length > 0 && (
      <section class="sektion" aria-labelledby="projekte-h">
        <div class="raster">
          <div class="sektion__kopf">
            <p class="eyebrow">
              <Icon name="blitz" size={16} />
              {t.nav.projekte}
            </p>
            <h2 id="projekte-h">{t.home.projekteH2}</h2>
          </div>
        </div>
        <div class="projekte">
          {projekte.map((p, i) => (
            <ProjektEintrag lang={lang} t={t} projekt={p} variante="startseite" seite={i % 2 === 0 ? 'rechts' : 'links'} />
          ))}
        </div>
        <div class="raster">
          <p class="sektion__fuss">
            <a class="textlink" href={path(lang, 'projekte')}>
              {t.home.alleProjekte}
              <Icon name="pfeil" size={20} />
            </a>
          </p>
        </div>
      </section>
    )
  }

  <section class="sektion flaeche marken" aria-labelledby="marken-h">
    <div class="raster">
      <div class="marken__inhalt">
        <h2 id="marken-h" class="sektion__kopf">{t.home.markenH2}</h2>
        <div class="marken__gruppe">
          <p class="label">{t.home.marken}</p>
          <ul class="marken__liste">
            {MARKEN.map((m) => <li class="marke">{m}</li>)}
          </ul>
        </div>
        <div class="marken__gruppe">
          <p class="label">{t.seiten.ueberUns.mitgliedH2}</p>
          <ul class="stichpunkte stichpunkte--gross">
            {t.seiten.ueberUns.mitglied.map((m) => <li>{m}</li>)}
          </ul>
          <p class="klein marken__hinweis" set:html={rich(t.seiten.ueberUns.mitgliedHinweis)} />
        </div>
      </div>
    </div>
  </section>

  <section class="sektion" aria-labelledby="faq-h">
    <div class="raster">
      <div class="faq-bereich">
        <h2 id="faq-h" class="sektion__kopf sektion__kopf--mitte">{t.home.faqH2}</h2>
        <Faq lang={lang} t={t} keys={FAQ_KEYS} />
      </div>
    </div>
  </section>

  <AnrufenSchreiben lang={lang} t={t} />
</Base>
