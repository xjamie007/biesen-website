---
/** Danke-Seite (F): was jetzt passiert, als <ol>. Nicht in Suchmaschinen (noindex). */
import Base from '@/layouts/Base.astro';
import Seitenkopf from '@/components/Seitenkopf.astro';
import { escapeHtml, rich, useT } from '@/i18n';
import { path, type Lang } from '@/i18n/config';
import { site, telHref } from '@/lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const s = t.seiten.danke;
const pfad = [
  { name: t.nav.home, href: path(lang, 'home') },
  { name: t.nav.kontakt, href: path(lang, 'kontakt') },
  { name: s.h1, href: path(lang, 'danke') },
];
const tel = `<a href="${telHref}" class="zahl">${escapeHtml(site.telefon.anzeige)}</a>`;
---
<Base lang={lang} route={{ page: 'danke' }} title={t.seo.danke.title} description={t.seo.danke.description} noindex>
  <Seitenkopf pfadLabel={t.a11y.pfad} pfad={pfad} h1={s.h1} intro={s.text} introHtml={{ tel }} />
  <section class="sektion" aria-labelledby="ablauf-h">
    <div class="raster">
      <div class="sp-text">
        <h2 id="ablauf-h">{s.ablaufH2}</h2>
        <ol class="ablauf">{s.ablauf.map((x) => <li>{x}</li>)}</ol>
        <p class="klein" set:html={rich(s.ablaufHinweis)} />
        <p class="sektion__fuss"><a href={path(lang, 'home')}>{s.zurueck}</a></p>
      </div>
    </div>
  </section>
</Base>
