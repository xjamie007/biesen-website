---
/** Über uns (E5): Symbolbild (bis das Teamfoto da ist), Familienbetrieb, Leitung [UNBESTÄTIGT], Geschichte als
 * Zeitleiste [UNBESTÄTIGT, nach der heutigen Website und dem Handelsregister], Sprachen, Mitgliedschaften als
 * Markenband (Namen als Schrift), Ort. */
import Base from '@/layouts/Base.astro';
import Markenband from '@/components/Markenband.astro';
import Seitenkopf from '@/components/Seitenkopf.astro';
import Foto from '@/components/Foto.astro';
import { escapeHtml, fmt, rich, useT } from '@/i18n';
import { path, type Lang } from '@/i18n/config';
import { breadcrumbs } from '@/lib/jsonld';
import { STOCK, STOCK_FOKUS } from '@/lib/stock';
import { adresseZeile, site } from '@/lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const s = t.seiten.ueberUns;
const pfad = [
  { name: t.nav.home, href: path(lang, 'home') },
  { name: t.nav.ueberUns, href: path(lang, 'ueberUns') },
];
---
<Base
  lang={lang}
  route={{ page: 'ueberUns' }}
  title={t.seo.ueberUns.title}
  description={t.seo.ueberUns.description}
  jsonld={[breadcrumbs(pfad.map((p) => ({ name: p.name, url: p.href })))]}
>
  <Seitenkopf pfadLabel={t.a11y.pfad} pfad={pfad} h1={s.h1} intro={s.intro} />

  <div class="sektion">
    <div class="raster">
      <Foto
        class="voll sp-bild-links"
        bild={STOCK.monteur}
        alt={t.stock.monteur}
        folgt={t.allgemein.fotoFolgt}
        motiv={t.home.teamFoto}
        fokus={STOCK_FOKUS.monteur}
        hinweis={`${t.allgemein.symbolbild} · ${fmt(t.allgemein.fotoFolgt, { motiv: t.home.teamFoto })}`}
        sizes="(min-width: 1024px) 66vw, 100vw"
      />
    </div>
  </div>

  <section class="sektion" aria-labelledby="leitung-h">
    <div class="raster">
      <div class="sp-text">
        <div class="block">
          <h2 id="leitung-h">{s.leitungH2}</h2>
          <p class="prosa" set:html={rich(s.leitung)} />
        </div>
        <div class="block">
          <h2>{s.geschichteH2}</h2>
          <ol class="zeitleiste">
            {
              s.geschichteSchritte.map((x) => (
                <li class="zeitleiste__schritt zeigen">
                  <span class="zeitleiste__jahr zahl">{x.jahr}</span>
                  <h3 class="zeitleiste__titel">{x.titel}</h3>
                  <p class="zeitleiste__text">{x.text}</p>
                </li>
              ))
            }
          </ol>
          <p class="klein" set:html={rich(s.geschichte)} />
        </div>
        <div class="block">
          <h2>{s.spracheH2}</h2>
          <p class="prosa" set:html={rich(s.sprache)} />
        </div>
        <div class="block">
          <h2>{s.mitgliedH2}</h2>
          <Markenband marken={s.mitglied} label={s.mitgliedH2} id="markenband-mitglied" groesse="klein" />
          <p class="klein" set:html={rich(s.mitgliedHinweis)} />
        </div>
        <div class="block">
          <h2>{s.ortH2}</h2>
          <p class="prosa">{s.ort}</p>
          <p class="prosa" set:html={escapeHtml(`${site.name}, ${adresseZeile}`)} />
          <p><a href={site.osm}>{s.karte}</a></p>
        </div>
        <div class="block">
          <h2>{s.jobsH2}</h2>
          <p class="prosa">
            {t.home.jobs} <a href={path(lang, 'jobs')}>{t.home.jobsLink}</a>
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
